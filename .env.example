# Database (SQLite file, relative to prisma/)
DATABASE_URL="file:./dev.db"

# Secret for signing session cookies. Use a long random string.
AUTH_SECRET="ganti-dengan-string-acak-panjang"

# Folder for WhatsApp Hub linked-device sessions (credentials, keep private).
WA_HUB_DIR=".wa-hub"

# AI provider for AI Agent replies and AI Response Test:
# "anthropic" (Claude, default) or "openai" (any OpenAI-compatible endpoint).
AI_PROVIDER="openai"
# OpenAI-compatible endpoint (used when AI_PROVIDER="openai").
OPENAI_BASE_URL="https://griphubrouter.web.id/v1"
OPENAI_MODEL="deepseek-v4.1-flash"
OPENAI_API_KEY=""
# Claude API (used when AI_PROVIDER="anthropic").
# Without the active provider's key, AI shows a clear "belum dikonfigurasi" message.
ANTHROPIC_API_KEY=""

# WhatsApp Cloud API (optional). Without these, outgoing messages are
# stored locally and marked as "simulasi".
# Token: permanent System User token from Meta Business Settings.
WHATSAPP_TOKEN=""
# Fallback when a device has no Phone Number ID of its own (single-number setups).
WHATSAPP_PHONE_NUMBER_ID=""
# Webhook (callback URL: https://<your-domain>/api/webhooks/whatsapp).
# Verify token: any random string; enter the same value in Meta App Dashboard.
WHATSAPP_VERIFY_TOKEN=""
# App secret (App Dashboard > App settings > Basic). Used to verify signatures.
WHATSAPP_APP_SECRET=""

# Shared secret for POST /api/webhooks/incoming (header: x-webhook-secret).
INCOMING_WEBHOOK_SECRET=""

# Coin cost per action. [TBD] Real pricing is not decided yet (see PRD 7.1),
# so the default is 0. The balance check still runs whenever a cost is set.
COIN_COST_AI_REPLY=0
COIN_COST_BROADCAST_MESSAGE=0

# OMS GRASON integration (contract cs-ai.v2). Without base URL + API key the
# integration is off and chat works as before. Never commit real values.
# Base URL including /api/v2, e.g. the OMS test environment's URL.
OMS_BASE_URL=""
# API key for system cs_ai (gok_...), given by the OMS team privately.
OMS_API_KEY=""
# Shared secret for the order.status_changed webhook (POST /api/webhooks/oms).
OMS_WEBHOOK_SECRET=""

# --- Vercel only (set in Project Settings > Environment Variables) ---
# DATABASE_URL / DATABASE_URL_UNPOOLED: PostgreSQL, set by the Neon integration.
# BLOB_READ_WRITE_TOKEN: set by connecting a Vercel Blob store (product images).
# SEED_ADMIN_PASSWORD: required; password for admin@centris.test on first deploy.
# CRON_SECRET: random string; Vercel Cron sends it to /api/cron/followup.

# Google sign-in / sign-up (optional). Create an OAuth client (Web application) in
# Google Cloud Console > APIs & Services > Credentials. Authorized redirect URI:
# <APP_URL>/api/auth/google/callback  (e.g. http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Public base URL of the app; defaults to the request origin.
APP_URL=""
