generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Single-tenant account settings (coins, integrations).
model Account {
  id              Int      @id @default(1)
  name            String
  coins           Int      @default(0)
  timezone        String   @default("Asia/Jakarta")
  webhookUrl      String?
  webhookEnabled  Boolean  @default(false)
  scalevApiKey    String?
  scalevEnabled   Boolean  @default(false)
  shippingFile    String?
  shippingAt      DateTime?
  // AI/LLM settings. Empty aiProvider = fall back to environment variables.
  aiProvider      String   @default("") // "openai" | "anthropic"
  aiBaseUrl       String   @default("")
  aiModel         String   @default("")
  aiApiKeyEnc     String   @default("") // AES-256-GCM, key derived from AUTH_SECRET
  // RajaOngkir shipping cost API. Empty key + no origin = integration off.
  rajaOngkirApiKeyEnc   String @default("") // AES-256-GCM, key derived from AUTH_SECRET
  rajaOngkirOriginId    Int? // Subdistrict ID from /destination/domestic-destination
  rajaOngkirOriginLabel String @default("")
  rajaOngkirCourier     String @default("jne")
  rajaOngkirWeight      Int    @default(1000) // default package weight in grams
  updatedAt       DateTime @updatedAt
}

/// J&T rates imported from Excel. REG: flat per package per kecamatan. CARGO: per kab/kota.
model ShippingRate {
  id        Int    @id @default(autoincrement())
  service   String // "REG" | "CARGO"
  warehouse String
  city      String
  district  String @default("")
  price     Int // REG: per package; CARGO: up to 10 kg
  tiers     String @default("") // CARGO: JSON [[maxKg | null, perKg], ...] above 10 kg
  sla       String @default("") // CARGO: e.g. "7-9" (days)

  @@index([service, city])
}

model CoinTransaction {
  id        Int      @id @default(autoincrement())
  amount    Int
  reason    String
  createdAt DateTime @default(now())
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String  @default("")
  permissions String  @default("") // comma separated module keys
  users       User[]
}

model Group {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id           Int             @id @default(autoincrement())
  name         String
  email        String          @unique
  phone        String          @default("")
  passwordHash String
  googleId     String?         @unique
  status       String          @default("active") // active | inactive
  roleId       Int
  role         Role            @relation(fields: [roleId], references: [id])
  groupId      Int?
  group        Group?          @relation(fields: [groupId], references: [id])
  devices      Device[]
  conversations Conversation[]
  broadcasts   Broadcast[]
  events       CalendarEvent[]
  apiTokens        ApiToken[]
  webhookEndpoints WebhookEndpoint[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Device {
  id            Int               @id @default(autoincrement())
  label         String
  phone         String
  apiType       String            @default("Cloud API")
  coex          Boolean           @default(false)
  status        String            @default("connected")
  connectedAt   DateTime          @default(now())
  // WhatsApp Hub only: folder name of the linked-device session under WA_HUB_DIR.
  hubSessionKey String?
  // Cloud API only: Meta "Phone number ID" used for sending and to route webhooks.
  phoneNumberId String?           @unique
  staff         User[]
  agents        AiAgent[]
  templates     MessageTemplate[]
  events        DeviceEvent[]
  conversations Conversation[]
  broadcasts    Broadcast[]
  createdAt     DateTime          @default(now())
}

model DeviceEvent {
  id        Int      @id @default(autoincrement())
  deviceId  Int
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
}

model MessageTemplate {
  id        Int      @id @default(autoincrement())
  deviceId  Int
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name      String
  category  String   @default("UTILITY")
  body      String
  createdAt DateTime @default(now())
}

model Customer {
  id            Int              @id @default(autoincrement())
  name          String
  phone         String           @unique
  email         String           @default("")
  notes         String           @default("")
  // "" = auto from chat history (NC or RO), or set by staff: "nc" | "ro" | "reseller"
  segment       String           @default("")
  // Opt-out contacts are skipped by campaign launches.
  optInWhatsapp Boolean          @default(true)
  stageId       Int?
  stage         FunnelStage?     @relation(fields: [stageId], references: [id], onDelete: SetNull)
  labels        Label[]
  conversation  Conversation?
  audiences     Audience[]
  events        CalendarEvent[]
  broadcastRecipients BroadcastRecipient[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Conversation {
  id              Int       @id @default(autoincrement())
  customerId      Int       @unique
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deviceId        Int?
  device          Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  assignedToId    Int?
  assignedTo      User?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  // "ai" = handled by AI agent, "staf" = handled by staff, "eskalasi" = escalated
  mode            String    @default("ai")
  modeChangedAt   DateTime?
  unread          Int       @default(0)
  lastMessageAt   DateTime  @default(now())
  lastInboundAt   DateTime?
  lastFollowupAt  DateTime?
  // When a delayed AI reply is due (see lib/ai-delay.ts); null = none pending.
  aiReplyDueAt    DateTime?
  messages        Message[]

  // OMS GRASON integration (see docs/oms/INTEGRASI-OMS-GRASON.md).
  // Lead.id from POST /leads. Not unique at the DB level so db push can add
  // the nullable column to existing deployments without a data-loss prompt;
  // the OMS module guarantees one lead per conversation.
  omsLeadId          String?
  omsLeadStatus      String? // baru | direspon | follow_up | closing | gagal
  omsFirstResponseAt DateTime?
  omsHandoverAt      DateTime?
  omsKanal           String? // click_to_whatsapp | landing_page | organik | lainnya
  omsCampaignId      String?
  omsAdsetId         String?
  omsAdId            String?
  omsReferral        String? // Raw Meta click-to-WhatsApp referral JSON
  omsCheckouts       OmsCheckout[]
  omsOrders          OmsOrder[]
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String       // "in" | "out"
  sender         String       // "customer" | "ai" | "staff" | "system"
  text           String
  status         String       @default("sent") // sent | delivered | read | failed | simulated
  // WhatsApp message id (wamid). Matches delivery receipts and dedupes webhook retries.
  externalId     String?      @unique
  // Photo/video sent from the media library (testimonials).
  mediaAssetId   Int?
  mediaAsset     MediaAsset?  @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
}

// Testimonial photos/videos the AI agent (or staff) can send in chat.
model MediaAsset {
  id        Int       @id @default(autoincrement())
  title     String
  kind      String    // "image" | "video"
  fileName  String    // local file name under uploads/media, or a Blob URL
  mimeType  String
  size      Int
  // When the AI may send it; shown to the AI in the system prompt.
  usage     String    @default("")
  // Sent with the photo/video in WhatsApp.
  caption   String    @default("")
  productId Int?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  active    Boolean   @default(true)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          Int              @id @default(autoincrement())
  name        String
  description String           @default("")
  aiPrompt    String           @default("")
  variants    ProductVariant[]
  images      ProductImage[]
  media       MediaAsset[]
  agents      AiAgent[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sku       String  @default("")
  weight    Int     @default(0) // gram
  price     Int     @default(0) // normal price
  salePrice Int? // promo price; null = no promo
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  size      Int
}

model Funnel {
  id      Int           @id @default(autoincrement())
  name    String
  levels  FunnelLevel[]
  agents  AiAgent[]
}

model FunnelLevel {
  id       Int           @id @default(autoincrement())
  funnelId Int
  funnel   Funnel        @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  order    Int
  stages   FunnelStage[]
}

model FunnelStage {
  id          Int         @id @default(autoincrement())
  levelId     Int
  level       FunnelLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  name        String
  description String      @default("")
  order       Int
  // Sequential number across the whole funnel, recalculated on every change.
  number      Int         @default(0)
  aiEnabled   Boolean     @default(true)
  customers   Customer[]
}

model Label {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  color     String     @default("#22c55e")
  customers Customer[]
}

model Audience {
  id        Int        @id @default(autoincrement())
  name      String
  type      String     @default("Manual") // Manual | Impor
  customers Customer[]
  broadcasts Broadcast[]
  createdAt DateTime   @default(now())
}

model Broadcast {
  id          Int       @id @default(autoincrement())
  name        String
  type        String    // "Single" | "Series"
  status      String    @default("Draft") // Draft | Terkirim | Gagal
  message     String
  deviceId    Int?
  device      Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  audienceId  Int?
  audience    Audience? @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  createdById Int?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sentCount   Int       @default(0)
  recipients  BroadcastRecipient[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AiAgent {
  id                 Int       @id @default(autoincrement())
  name               String
  description        String    @default("")
  baseLearning       String    @default("Customer Service")
  personality        String    @default("")
  active             Boolean   @default(true)
  maxReplyChars      Int       @default(600)
  // Random wait before an AI reply (seconds, 0 = reply at once). Messages that
  // arrive during the wait are answered together in one reply.
  replyDelayMinSec   Int       @default(0)
  replyDelayMaxSec   Int       @default(0)
  escalationEnabled  Boolean   @default(false)
  escalationKeywords String    @default("") // comma separated
  escalationMessage  String    @default("")
  followupEnabled    Boolean   @default(false)
  followupDelayHours Int       @default(24)
  followupMessage    String    @default("")
  webhookOnReply     Boolean   @default(false)
  // AI-order mode: the agent may create (and optionally verify) OMS orders itself.
  autoOrder          Boolean   @default(false)
  autoVerifyOrders   Boolean   @default(false)
  funnelId           Int?
  funnel             Funnel?   @relation(fields: [funnelId], references: [id], onDelete: SetNull)
  products           Product[]
  devices            Device[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model CalendarEvent {
  id         Int       @id @default(autoincrement())
  title      String
  date       DateTime
  notes      String    @default("")
  staffId    Int?
  staff      User?     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
}

// --- OMS GRASON integration -------------------------------------------------

/// One POST /orders call. A checkout can produce two orders (one per entitas).
model OmsCheckout {
  id             Int          @id @default(autoincrement())
  externalId     String       @unique // OMS external_id (chk_<conversationId>_<uuid>)
  orderGroupId   String?      @unique
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  leadId         String? // OMS lead UUID used for this checkout
  status         String       @default("pending") // pending | created | failed
  createdByAi    Boolean      @default(false)
  payload        String       @default("{}") // OrderBaru JSON (lead_id filled at send time)
  lastError      String?
  notifiedAt     DateTime? // Customer summary was sent
  orders         OmsOrder[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([status])
}

/// Mirror of an OMS order. Never used as the source of truth for price/stock.
model OmsOrder {
  id                     Int          @id @default(autoincrement())
  omsOrderId             String       @unique // Order.id from OMS
  nomor                  String
  orderGroupId           String?
  checkoutId             Int
  checkout               OmsCheckout  @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  conversationId         Int
  conversation           Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  entitas                String
  status                 String
  metodeBayar            String
  subtotal               Int          @default(0)
  diskon                 Int          @default(0)
  ongkir                 Int          @default(0)
  subsidiOngkir          Int          @default(0)
  biayaCod               Int          @default(0)
  subsidiAdminCod        Int          @default(0)
  total                  Int          @default(0)
  nilaiCod               Int          @default(0)
  segmen                 String?
  perluVerifikasiManusia Boolean      @default(false)
  itemsJson              String       @default("[]")
  pengirimanJson         String?
  lastEventAt            DateTime?
  lastPolledAt           DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([conversationId])
  @@index([nomor])
  @@index([status])
}

/// Durable queue for writes that must reach OMS even when it is temporarily down.
model OmsOutbox {
  id            Int       @id @default(autoincrement())
  kind          String // create_lead | patch_lead | create_order | verify_order
  dedupeKey     String?   @unique
  payload       String
  status        String    @default("pending") // pending | processing | done | failed
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
}

/// Inbound OMS webhook events, deduped by event_id.
model OmsWebhookEvent {
  id          Int       @id @default(autoincrement())
  eventId     String    @unique
  jenis       String
  terjadiAt   DateTime
  payload     String
  attempts    Int       @default(0)
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([processedAt, createdAt])
}

// --- Developer platform -----------------------------------------------------

/// Personal access token for the REST API. Only the SHA-256 hash is stored.
model ApiToken {
  id         Int       @id @default(autoincrement())
  name       String
  prefix     String // first 8 random chars, safe to display
  tokenHash  String    @unique // SHA-256 of the full token
  scopes     String    @default("") // comma separated; "*" = full access
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Outbound webhook endpoint. `events` empty means every event.
model WebhookEndpoint {
  id          Int      @id @default(autoincrement())
  name        String
  url         String
  secret      String // whsec_..., shown once in the UI
  events      String   @default("")
  description String   @default("")
  enabled     Boolean  @default(true)
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deliveries  WebhookDelivery[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}

model WebhookDelivery {
  id         Int             @id @default(autoincrement())
  endpointId Int
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event      String
  eventId    String
  statusCode Int?
  success    Boolean         @default(false)
  durationMs Int             @default(0)
  error      String?
  createdAt  DateTime        @default(now())

  @@index([endpointId, createdAt])
}

/// Per-customer delivery status for a broadcast campaign.
model BroadcastRecipient {
  id          Int       @id @default(autoincrement())
  broadcastId Int
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // pending | sent | failed
  error       String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@unique([broadcastId, customerId])
  @@index([broadcastId, status])
}
